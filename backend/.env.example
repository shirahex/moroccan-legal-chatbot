# Legacy defaults are retained in fullpipeline.py for compatibility.
# GOOGLE_CHAT_MODEL=your_supported_chat_model
# GOOGLE_TRANSLATE_MODEL=your_supported_chat_model
# GOOGLE_EMBEDDING_MODEL=your_supported_embedding_model

